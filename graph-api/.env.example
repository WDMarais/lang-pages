# Postgres connection. Peer auth over the unix socket needs no password,
# so PGHOST is the socket directory rather than a TCP host.
PGHOST=/var/run/postgresql
PGDATABASE=lang_pages_graph

# Optional: log the DB-query count per GraphQL operation (the N+1 probe).
# Off by default; set to 1 to see batching collapse 2N+1 round-trips to a constant.
# GRAPH_API_PROBE=1
