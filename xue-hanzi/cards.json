      "meaning": "to tell (someone something)",
      "meaning_zh": "把消息、意思说给别人知道",
      "theme": "t-navy",
      "examples": [
        {
          "zh": "请你告诉我，这个汉字怎么写？",
          "en": "Please tell me, how do you write this character?",
          "audio": {
            "晓晓": "audio/gaosu-xiaoxiao.mp3",
            "晓伊": "audio/gaosu-xiaoyi.mp3",
